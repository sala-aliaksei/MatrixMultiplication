{
    "editor.formatOnSave": true,
    // Using clangd extension for formatting (it uses clang-format under the hood)
    // clangd will automatically use your .clang-format file
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true
    },
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true
    },
    "[cuda]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true
    },
    // clangd formatting settings
    "clangd.formatting.style": "file",
    "clangd.fallbackFlags": [],
    // --- TestMate basics ---
    "testMate.cpp.log.logpanel": true,
    // If your test exe isn't named *test*, set explicit patterns:
    "testMate.cpp.test.executables": "",
    "testMate.cpp.test.advancedExecutables": [
        {
            "name": "Tests: ${filename}",
            "pattern": "build/Release/Test*",
            "cwd": "${workspaceFolder}",
            "env": {
                "LD_LIBRARY_PATH": "/home/aliaksei/wp/gcc-16/lib64:/home/aliaksei/wp/gcc-16/lib/gcc/x86_64-linux-gnu/16.0.0:${env:LD_LIBRARY_PATH}"
            }
        },
        {
            "name": "Benchmarks: ${filename}",
            "pattern": "build/Release/BM_*",
            "cwd": "${workspaceFolder}",
            "env": {
                "LD_LIBRARY_PATH": "/home/aliaksei/wp/gcc-16/lib64:/home/aliaksei/wp/gcc-16/lib/gcc/x86_64-linux-gnu/16.0.0:${env:LD_LIBRARY_PATH}"
            }
        }
    ],
    // Optional quality-of-life
    "testMate.cpp.test.parallelExecutionLimit": 4,
    "testMate.cpp.discovery.loadOnStartup": true
}