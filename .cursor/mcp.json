{
    "mcpServers": {
      "clang-tidy": {
        "command": "uv",
        "args": [ "run", "${workspaceFolder}/tools/clang-tidy-server.py"]
      },
      "cpp-tools": {
        "command": "mcp-cpp-server",
        "env": {
          "CLANGD_PATH": "/usr/bin/clangd-20"
        }
      },
      "clang-file-verification": {
        "command":"uv",
        "args": ["run", "${workspaceFolder}/tools/clang-verify-file-server.py"]
      },
      "llvm-mca":{
        "command": "uv",
        "args" : ["run", "${workspaceFolder}/tools/llvm-mca-server.py"]
      }
    }
  }